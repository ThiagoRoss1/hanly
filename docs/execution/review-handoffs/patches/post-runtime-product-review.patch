=\"display:flex;justify-content:center\"><div style=\"width:2px;height:29px;background:#3f8194\"></div></div>\n        </div>\n      </div>\n\n      <!-- WAVE 7 -->\n      <div style=\"padding-top:6px\">\n        <div style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.1em;color:#8b9096\">WAVE 7</div>\n        <div style=\"margin-top:3px;font-size:14px;font-weight:600;line-height:1.3\">Automatic Hover Runtime</div>\n      </div>\n      <div>\n        <div style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:14px;align-items:start\">\n          <div style=\"grid-column:1 / span 4;position:relative;padding-right:56px\">\n            <div style=\"position:absolute;right:0;top:0;width:56px;height:260px\">\n              <div style=\"position:absolute;right:8px;top:0;width:2px;height:252px;background:#8a5f96\"></div>\n              <div style=\"position:absolute;left:9px;right:8px;top:251px;height:2px;background:#8a5f96\"></div>\n              <div style=\"position:absolute;left:0;top:246px;width:0;height:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-right:9px solid #8a5f96\"></div>\n              <div style=\"position:absolute;right:17px;top:218px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#6b4576;white-space:nowrap\">Basic Control Center · approved gate</div>\n            </div>\n            <div style=\"border:1.5px solid #2c3138;background:#fff;border-radius:8px;padding:12px 14px\">\n              <div style=\"font-size:17px;font-weight:600\">Mouse Observer</div>\n              <div style=\"margin-top:5px;font-size:13px;line-height:1.45;color:#6d7278\">Global cursor monitoring.</div>\n            </div>\n            <div style=\"display:flex;flex-direction:column;align-items:center;margin:0 auto\"><div style=\"width:3px;height:20px;background:#2c3138\"></div><div style=\"width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:9px solid #2c3138\