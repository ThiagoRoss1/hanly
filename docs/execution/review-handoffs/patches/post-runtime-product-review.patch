">Repository Foundation</div>\n            <div style=\"font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8b9096\">root node · blocks everything</div>\n          </div>\n          <div style=\"margin-top:9px;display:flex;flex-wrap:wrap;gap:6px\">\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">monorepo</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">hanly package</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">hanly-app package</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">Python 3.10+</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">pyproject config</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">test scaffold</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">lint / type checking</div>\n            <div style=\"border:1px solid #d6d9dc;border-radius:4px;padding:4px 8px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#3d4249\">minimal CI</div>\n          </div>\n        </div>\n        <div style=\"margin-top:10px;display:grid;grid-template-columns:56px 1fr;gap:14px;align-items:stretch\">\n          <div style=\"position:relative;min-height:94px\">\n            <div style=\"position:absolute;left:27px;top:0;bottom:9px;width:3px;background:#2c3138\"></div>\n         