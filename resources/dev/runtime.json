{
  "manifest_version": 1,
  "resources": {
    "paddle_detection_model": {
      "kind": "directory",
      "path": "models/PP-OCRv5_mobile_det",
      "version": "PP-OCRv5_mobile_det"
    },
    "paddle_recognition_model": {
      "kind": "directory",
      "path": "models/korean_PP-OCRv5_mobile_rec",
      "version": "korean_PP-OCRv5_mobile_rec"
    },
    "krdict": {
      "kind": "krdict",
      "path": "krdict/krdict.sqlite3",
      "version": "1"
    }
  },
  "paddle": {
    "text_detection_model_name": "PP-OCRv5_mobile_det",
    "text_detection_model_dir": "models/PP-OCRv5_mobile_det",
    "text_recognition_model_name": "korean_PP-OCRv5_mobile_rec",
    "text_recognition_model_dir": "models/korean_PP-OCRv5_mobile_rec",
    "use_doc_orientation_classify": false,
    "use_doc_unwarping": false,
    "use_textline_orientation": false,
    "enable_mkldnn": false
  }
}
